{
  "name": "hedayat-alhuffaz",
  "version": "0.1.0",
  "description": "نظام إدارة مقرأة لحفظ القرآن — رصد يومي وترتيب وإدارة دفعات، على Cloudflare Workers + D1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute hedayat-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute hedayat-db --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute hedayat-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
